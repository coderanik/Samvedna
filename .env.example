# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Legacy names (Dashboard → Settings → API):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# New Supabase key names (also supported):
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Frontend uses publishable key (same as anon key in most Supabase projects)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Google OAuth (Supabase Auth → Providers → Google) ────────────────────────
# 1. Google Cloud Console → Credentials → OAuth 2.0 Client (Web)
# 2. Authorized redirect URI must include:
#    https://YOUR_PROJECT.supabase.co/auth/v1/callback
# 3. Paste Client ID + Secret into Supabase Google provider
# 4. Supabase → Authentication → URL Configuration → Redirect URLs, add:
#    http://localhost:3000/auth/callback
#    samvedna://auth/callback
#    (Expo Go) exp://127.0.0.1:8081/--/auth/callback
# No app env vars needed — keys live in the Supabase dashboard.

# ─── Frontend (apps/web) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost:8001

# ─── Express API (apps/api) ───────────────────────────────────────────────────
PORT=4000
ML_SERVICE_URL=http://localhost:8001
SOCKET_CORS_ORIGIN=http://localhost:3000

# ─── ML Service (services/ml-service) ─────────────────────────────────────────
ML_PORT=8001
GEMINI_API_KEY=your-gemini-api-key
# Optional: defaults to gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# ─── Exotel (telephony — recommended for India) ───────────────────────────────
# Get keys: Exotel Dashboard → API Settings. ExoPhone → EXOTEL_CALLER_ID.
# Webhooks need a public URL (ngrok/cloud deploy): EXOTEL_WEBHOOK_BASE_URL
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_CALLER_ID=
# Public base URL for webhooks, e.g. https://abc123.ngrok.io or https://api.yourdomain.com
EXOTEL_WEBHOOK_BASE_URL=
# Optional: SMS (DLT required for India transactional SMS)
# EXOTEL_SMS_SENDER_ID=SAMVDN
# EXOTEL_DLT_ENTITY_ID=
# EXOTEL_DLT_TEMPLATE_ID=
# EXOTEL_IVRS_APP_ID=

# ─── Twilio Conversational Voice (instant agent calls) ────────────────────────
# Console: https://console.twilio.com → Account SID + Auth Token
# Buy / verify a number → TWILIO_FROM_NUMBER (E.164, e.g. +1415… or Indian Twilio number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS base that Twilio can reach (ngrok http 4000 → https://xxxx.ngrok.io)
# Required for LIVE phone calls. Voice/gather/status webhooks are served under this base.
TWILIO_WEBHOOK_BASE_URL=
# Optional: TTS voice (default Polly.Aditi). Also: Google.hi-IN-Wavenet-A, Alice
# TWILIO_VOICE=Polly.Aditi
# Max survivor speech turns before polite hangup (default 8)
# TWILIO_MAX_TURNS=8
# Local only — skip X-Twilio-Signature (never in production)
# TWILIO_SKIP_SIGNATURE_VALIDATION=true
#
# Setup check:  GET http://localhost:4000/webhooks/twilio/config
# Inbound: Twilio number Voice webhook → POST {TWILIO_WEBHOOK_BASE_URL}/webhooks/twilio/voice
# Optional TwiML / Conversational AI override (not needed — Samvedna serves its own TwiML):
# TWILIO_TWIML_URL=
