# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Legacy names (Dashboard → Settings → API):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# New Supabase key names (also supported):
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Frontend uses publishable key (same as anon key in most Supabase projects)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Frontend (apps/web) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost:8001

# ─── Express API (apps/api) ───────────────────────────────────────────────────
PORT=4000
ML_SERVICE_URL=http://localhost:8001
SOCKET_CORS_ORIGIN=http://localhost:3000

# ─── ML Service (services/ml-service) ─────────────────────────────────────────
ML_PORT=8001
GEMINI_API_KEY=your-gemini-api-key
# Optional: defaults to gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# ─── Exotel (telephony — recommended for India) ───────────────────────────────
# Get keys: Exotel Dashboard → API Settings. ExoPhone → EXOTEL_CALLER_ID.
# Webhooks need a public URL (ngrok/cloud deploy): EXOTEL_WEBHOOK_BASE_URL
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_CALLER_ID=
# Public base URL for webhooks, e.g. https://abc123.ngrok.io or https://api.yourdomain.com
EXOTEL_WEBHOOK_BASE_URL=
# Optional: SMS (DLT required for India transactional SMS)
# EXOTEL_SMS_SENDER_ID=SAMVDN
# EXOTEL_DLT_ENTITY_ID=
# EXOTEL_DLT_TEMPLATE_ID=
# EXOTEL_IVRS_APP_ID=
