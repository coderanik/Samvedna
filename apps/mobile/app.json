{
  "expo": {
    "name": "Samvedna",
    "slug": "samvedna-victim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "samvedna",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F3D3E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.samvedna.victim",
      "infoPlist": {
        "NSCameraUsageDescription": "Samvedna needs the camera for optional video calls with your counsellor.",
        "NSMicrophoneUsageDescription": "Samvedna needs the microphone for Metal AI and counsellor calls.",
        "NSSpeechRecognitionUsageDescription": "Optional voice input for check-ins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D3E"
      },
      "package": "org.samvedna.victim",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "samvedna",
              "host": "onboard",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Samvedna to use the camera for counsellor video calls."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F3D3E",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c988df8a-0eca-4f20-bafc-032cf8a735f0"
      }
    }
  }
}
